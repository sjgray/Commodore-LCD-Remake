  (text "Locking MX switches are hard to get,\nbut If you have one it can be used.\n\n"
    (at 100.965 172.085 0)
    (effects (font (size 1.5494 1.5494)) (justify left bottom))
    (uuid 00f3ea8b-8a54-4e56-84ff-d98f6c00496c)
  )
  (text "2U" (at 165.1 271.145 0)
    (effects (font (size 5.9944 5.9944)) (justify left bottom))
    (uuid 49ae6c27-ef6e-4c4c-b1b4-02869f1e6f05)
  )
  (text "Sparebar on original is 8U, but that size\nis not available, so we use 6U.\nWe add an extra 1U to either side."
    (at 169.545 173.355 0)
    (effects (font (size 1.5494 1.5494)) (justify left bottom))
    (uuid 52fe3452-50bc-400a-a49c-297b930f2010)
  )
  (text "1.75U" (at 110.49 271.145 0)
