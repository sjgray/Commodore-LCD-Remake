  (text "The MA lines normally will go through\nthe CPLD, but for here we are just\npassing the normal CPU address lines\nto the equivilent MA line. The upper\nMA lines will be grounded as they are\nnot used. This limits us to 64K of\nRAM or ROM."
    (at 46.99 125.095 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 3e8173d1-8b8f-4303-a923-4d6a24a3339d)
  )
