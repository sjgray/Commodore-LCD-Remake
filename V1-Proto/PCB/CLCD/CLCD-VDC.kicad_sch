  (text "512\nK" (at 324.485 76.2 0)
    (effects (font (size 3.9878 3.9878)) (justify left bottom))
    (uuid e186d8a8-0365-4677-ab8d-0968ff53930b)
  )
  (text "The VDC uses DRAM. Latch converts\nthe signals to a full 16-bit\naddress suitable for SRAM memory.\n"
    (at 79.375 240.03 0)
    (effects (font (size 1.54 1.54)) (justify left bottom))
    (uuid e8056a34-cdc2-4cb9-ac02-9ab96a1bdfd6)
  )
  (text "This has RGB Digital signal levels,\nfor use with CGA monitors such as\nthe Commodore 1084."
    (at 301.625 298.45 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid e97a5e7f-46d9-4937-85c0-cc571e526231)
  )
  (text "PLCC" (at 410.845 240.03 90)
    (effects (font (size 4 4)) (justify left bottom))
    (uuid e99db04a-31e6-462f-8542-e576a9fc4119)
  )
  (text "When VDC_RC7 is LOW the DPRAM is\nselected, otherwise the UPPER\n32K space is selected.\nThe UPPER space can contain\nRAM or ROM as selected by\nthe VDC_UPSEL line."
    (at 89.535 272.415 0)
    (effects (font (size 1.54 1.54)) (justify left bottom))
    (uuid ee53f3f8-3014-4b5f-8428-802e1837538a)
  )
