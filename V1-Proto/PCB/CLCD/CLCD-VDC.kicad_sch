  )
  (text "The VDC replaces the CLCD custom gate array\nsince it requires few external components\nand can be programmed to generate various\nscreen configurations, such as the 6x8 pixel\ncharacter format and the 128 bytes per line\nof the CLCD as well as the 8x8/16 pixel sizes.\n"
    (at 13.97 298.45 0)
    (effects (font (size 1.54 1.54)) (justify left bottom))
    (uuid 6e53512c-e7d3-4cf2-9bc4-63ed933e129f)
