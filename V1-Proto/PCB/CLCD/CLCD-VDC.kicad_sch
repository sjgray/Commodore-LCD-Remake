  (text "VDC RAM\nRAM 512K\nROM 1MB\nVDC\nKBD,IEC\nCENTR, RTC\nACIA\nCPU CLOCK\nDOT CLOCK\nVDC OPTION\nFONT HI"
    (at 196.85 71.755 0)
